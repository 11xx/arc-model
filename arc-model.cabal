cabal-version:      3.0
name:               arc-model
version:            0.1.0.0
synopsis:           Independent semantic model of arc authorization
description:
  A pure Haskell characterization of arc's authorization semantics: what a
  recorded history permits, what it refuses, and which facts a decision
  rests on. The model is independent of the Rust implementation; it is not
  a port of it.
license:            Unlicense
author:             arc contributors
build-type:         Simple
category:           Development

common warnings
  default-language:   GHC2024
  default-extensions:
      DuplicateRecordFields
    , NoFieldSelectors
    , OverloadedRecordDot
  ghc-options:        -Wall -Werror

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
      Arc.Model
    , Arc.Model.Basis
    , Arc.Model.Coverage
    , Arc.Model.Decision
    , Arc.Model.Declaration
    , Arc.Model.Discharge
    , Arc.Model.Gate
    , Arc.Model.Identifiers
    , Arc.Model.Ledger
    , Arc.Model.Ledger.Audit
    , Arc.Model.Ledger.Claim
    , Arc.Model.Ledger.Debt
    , Arc.Model.Ledger.Disposition
    , Arc.Model.Ledger.ExternalVerdict
    , Arc.Model.Ledger.Finding
    , Arc.Model.Ledger.Integration
    , Arc.Model.Ledger.Patchset
    , Arc.Model.Ledger.Verdict
    , Arc.Model.Ledger.Verification
    , Arc.Model.Observations
    , Arc.Model.Observed
    , Arc.Model.Policy
    , Arc.Model.State
  build-depends:
      base        >= 4.21 && < 4.22
    , containers  >= 0.7  && < 0.8

test-suite spec
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
      Fixtures
    , Generators
    , Mutants
    , Render
    , Scenario
  build-depends:
      arc-model
    , base        >= 4.21 && < 4.22
    , containers  >= 0.7  && < 0.8
    , QuickCheck  >= 2.14 && < 2.16
