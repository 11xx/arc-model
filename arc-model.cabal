cabal-version:      3.0
name:               arc-model
version:            0.1.0.0
synopsis:           Independent semantic model of arc authorization
description:
  A pure Haskell characterization of arc's authorization semantics: what a
  recorded history permits, what it refuses, and which facts a decision
  rests on. The model is independent of the Rust implementation; it is not
  a port of it. The differential executable replays generated histories
  through the arc binary and compares its answer with the model's.
license:            Unlicense
license-file:       UNLICENSE
author:             arc contributors
build-type:         Simple
category:           Development
homepage:           https://github.com/11xx/arc-model
bug-reports:        https://github.com/11xx/arc-model/issues

source-repository head
  type:     git
  location: https://github.com/11xx/arc-model

common warnings
  default-language:   GHC2024
  default-extensions:
      DuplicateRecordFields
    , NoFieldSelectors
    , OverloadedRecordDot
  ghc-options:        -Wall -Werror

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
      Arc.Model
    , Arc.Model.Basis
    , Arc.Model.Coverage
    , Arc.Model.Decision
    , Arc.Model.Declaration
    , Arc.Model.Discharge
    , Arc.Model.Gate
    , Arc.Model.Identifiers
    , Arc.Model.Ledger
    , Arc.Model.Ledger.Audit
    , Arc.Model.Ledger.Brief
    , Arc.Model.Ledger.Claim
    , Arc.Model.Ledger.Debt
    , Arc.Model.Ledger.DirtyTreeWaiver
    , Arc.Model.Ledger.Disposition
    , Arc.Model.Ledger.ExternalVerdict
    , Arc.Model.Ledger.Finding
    , Arc.Model.Ledger.Integration
    , Arc.Model.Ledger.Patchset
    , Arc.Model.Ledger.ProbeRun
    , Arc.Model.Ledger.Verdict
    , Arc.Model.Ledger.Verification
    , Arc.Model.Observations
    , Arc.Model.Observed
    , Arc.Model.Policy
    , Arc.Model.Probe
    , Arc.Model.State
  build-depends:
      base        >= 4.21 && < 4.22
    , containers  >= 0.7  && < 0.8

-- the scenario plan, its generators, and the deliberate faults, shared by
-- the spec and the differential
library scenarios
  import:           warnings
  hs-source-dirs:   scenarios
  exposed-modules:
      Generators
    , Mutants
    , Scenario
  build-depends:
      arc-model
    , base        >= 4.21 && < 4.22
    , containers  >= 0.7  && < 0.8
    , QuickCheck  >= 2.14 && < 2.16

-- the proposed candidate protocol: a separate model that depends on the
-- main library for shared identifiers and observations and nothing else of
-- it; the main library cannot depend on it without a cycle
library candidate
  import:           warnings
  hs-source-dirs:   candidate
  exposed-modules:
      Arc.Candidate
    , Arc.Candidate.Basis
    , Arc.Candidate.Context
    , Arc.Candidate.Evaluation
    , Arc.Candidate.Identifiers
    , Arc.Candidate.Observations
    , Arc.Candidate.Registration
    , Arc.Candidate.Relation
    , Arc.Candidate.Retention
    , Arc.Candidate.Selection
    , Arc.Candidate.State
  build-depends:
      arc-model
    , base        >= 4.21 && < 4.22
    , containers  >= 0.7  && < 0.8

-- the comparator the differential adjudicates with is pinned here, so the
-- suite checks it without running arc
test-suite spec
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test, differential
  main-is:          Main.hs
  other-modules:
      Comparator
    , Differential.Arc
    , Differential.Compare
    , Differential.Plan
    , Differential.Sandbox
    , Fixtures
    , Render
    , SandboxChecks
  build-depends:
      arc-model
    , arc-model:scenarios
    , aeson       >= 2.2  && < 3
    , base        >= 4.21 && < 4.22
    , bytestring  >= 0.12 && < 1
    , containers  >= 0.7  && < 0.8
    , directory   >= 1.3  && < 2
    , filepath    >= 1.5  && < 2
    , process     >= 1.6  && < 2
    , QuickCheck  >= 2.14 && < 2.16
    , unix        >= 2.8  && < 3

executable arc-model-differential
  import:           warnings
  hs-source-dirs:   differential
  main-is:          Main.hs
  other-modules:
      Differential.Arc
    , Differential.Compare
    , Differential.Plan
    , Differential.Sandbox
  build-depends:
      arc-model
    , arc-model:scenarios
    , aeson       >= 2.2  && < 3
    , base        >= 4.21 && < 4.22
    , bytestring  >= 0.12 && < 1
    , containers  >= 0.7  && < 0.8
    , directory   >= 1.3  && < 2
    , filepath    >= 1.5  && < 2
    , process     >= 1.6  && < 2
    , QuickCheck  >= 2.14 && < 2.16
    , unix        >= 2.8  && < 3

test-suite candidate-spec
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   candidate-test
  main-is:          Main.hs
  other-modules:
      Fixtures
    , Mutants
    , Plan
    , Render
  build-depends:
      arc-model
    , arc-model:candidate
    , base        >= 4.21 && < 4.22
    , containers  >= 0.7  && < 0.8
    , QuickCheck  >= 2.14 && < 2.16
